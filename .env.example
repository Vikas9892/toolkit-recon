# Copy to .env and fill in. .env is gitignored.

# Composio Platform project key (ak_...). Powers the search/fetch layer.
# Dashboard -> Platform -> project -> Getting Started -> Step 1
COMPOSIO_API_KEY=

# Stable identity for the Composio session. Any stable string works for a
# single-operator research pipeline; a real product would pass its own user id.
COMPOSIO_USER_ID=toolkit-recon

# LLM used for schema-constrained extraction (OpenAI-compatible endpoint).
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Optional overrides
TOOLKIT_RECON_CONCURRENCY=8
TOOLKIT_RECON_DOMAIN_DELAY=1.5
