# Copy to .env and fill in. .env is gitignored.

# --- Composio (search/fetch layer) ---
# Platform project key (ak_...). Dashboard -> Platform -> Getting Started.
COMPOSIO_API_KEY=
# Stable identity for the Composio session. Any stable string works for a
# single-operator research pipeline; a product would pass its own user id.
COMPOSIO_USER_ID=toolkit-recon

# --- LLM (schema-constrained extraction, OpenAI-compatible endpoint) ---
# Either GROQ_API_KEY or LLM_API_KEY; LLM_API_KEY wins if both are set.
GROQ_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Must support strict JSON-schema structured output. Verified: gpt-oss-20b and
# gpt-oss-120b do; qwen3.6-27b returns json_validate_failed.
LLM_MODEL=openai/gpt-oss-20b

# --- Rate governing ---
# Providers enforce a per-DAY cap as well as per-minute. The governor models
# the per-minute one; the per-day cap surfaces as DailyQuotaExhausted and
# aborts the run with the checkpoint intact.
LLM_TOKENS_PER_MINUTE=8000
LLM_CONCURRENCY=2

# --- Pipeline ---
TOOLKIT_RECON_CONCURRENCY=8
TOOLKIT_RECON_DOMAIN_DELAY=1.5
